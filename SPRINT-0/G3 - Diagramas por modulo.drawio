        <UserObject label="" plantUmlData="{&#10;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam monochrome true\nskinparam backgroundcolor white\n\nclass Seccion {\n\nid: int\n\nnombre: str {s50, único}\n\norden: int {&gt;0, único entre activas}\n\nestado: Estado = ACTIVO\n\nagregarProducto(p: Producto)\n\nmodificar(datos)\n\ndarDeBaja()\n\nreactivar()\n}\n\nclass Producto {\n\nid: int\n\nnombre: str {s100, único por categoría}\n\ncategoria: Categoria\n\nprecio: Decimal {&gt;0, 2 decimales}\n\ningredientes: str [0..*] {x1 salvo BEBIDA}\n\ndescripcion: str [0..1] {s500}\n\nimagen: str [0..1] {JPG/PNG/HEIC, s50}\n\netiquetas: str [0..*] {s30, sin repetir}\n\nestado: Estado = ACTIVO\n\nmodificar(datos)\n\ndarDeBaja()\n\nreactivar()\n}\n\nclass ItemComanda {\n\ncantidad: int {&gt;0}\n{xor} producto o menuEjecutivo\n}\n\nclass Comanda {\n\nfechaHora: datetime\n}\n\nclass MenuEjecutivo {\n\nnombre: str {único}\n\nprecioFijo: Decimal {&gt;0}\n}\n\nclass ReporteProductosMasVendidos {\n\nfechaDesde: date\n\nfechaHasta: date {m fechaDesde}\n\ngenerar(): List[LineaReporte]\n}\n\nclass LineaReporte {\n\nproducto: Producto\n\ncantidadPedido: int\n\ndiasMasPedidos: DiaSemana [1..*]\n\nfranjasMasPedidos: int [1..*] {hora 0-23}\n}\n\nclass Estado &lt;&gt; {\nACTIVO\nBAJA\n}\n\nclass DiaSemana &lt;&gt; {\nLUNES\nMARTES\nMIÉRCOLES\nJUEVES\nVIERNES\nSÁBADO\nDOMINGO\n}\n\nclass Categoria &lt;&gt; {\nPLATO\nPOSTRE\nBEBIDA\nMENU_DEL_DIA\n}\n\nSeccion \&quot;1\&quot; -- \&quot;0..\&quot; Producto : agrupa &gt;\nProducto \&quot;1\&quot; -- \&quot;1..\&quot; MenuEjecutivo : incluye &gt;\nProducto \&quot;0..1\&quot; -- \&quot;0..\&quot; ItemComanda\nMenuEjecutivo \&quot;0..1\&quot; -- \&quot;0..\&quot; ItemComanda\nItemComanda \&quot;1..\&quot; -- \&quot;1\&quot; Comanda\nComanda .. ReporteProductosMasVendidos : &lt;&gt;\nReporteProductosMasVendidos \&quot;1\&quot; -- \&quot;0..\&quot; LineaReporte : devuelve &gt;\n\n@enduml&quot;,&#10;  &quot;config&quot;: null&#10;}" id="wWQVureFu5YVy9d1Sryh-0">
